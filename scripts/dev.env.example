# Sample local settings for scripts/dev.sh. Copy it to .dev.env in the repo
# root (gitignored) and change what you need; scripts/dev.sh loads it on start.
# Every line is optional: the values below are the defaults.
#
# These are development-only values. The demo password is deliberately weak and
# only the dev seeder can write it. Never reuse any of this for a real install.

# Control plane, web UI and the loopback-only practice target.
ARES_ADDR=:8080
WEB_PORT=5173
PRACTICE_ADDR=127.0.0.1:8089

# Where the seeded file store, master key and demo agent state live.
# DEV_DIR=.dev

# Demo super-admin (sign-in for the seeded demo).
DEV_EMAIL=admin@northwind.db
DEV_PASSWORD=admin

# Demo agent: on | off (same as --no-agent).
DEV_AGENT=on

# PostgreSQL container: auto | on | off, and which runtime starts it.
ARES_PG=auto
ARES_PG_RUNTIME=auto
ARES_PG_PORT=55433
# ARES_PG_USER=ares
# ARES_PG_PASSWORD=ares-dev
# ARES_PG_DB=ares

# Optional AI advisor and OSINT keys are set in the app (Settings page), sealed
# with the dev master key, so they are not configured here.
